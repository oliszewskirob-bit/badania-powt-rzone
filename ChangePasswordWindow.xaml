<Window x:Class="ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zmień hasło" Height="260" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Wymagana zmiana hasła" />

        <TextBlock Grid.Row="1" Margin="0,14,0,4" Text="Nowe hasło"/>
        <PasswordBox x:Name="NewPassBox" Grid.Row="1" Margin="0,34,0,0"/>

        <TextBlock Grid.Row="2" Margin="0,14,0,4" Text="Powtórz nowe hasło"/>
        <PasswordBox x:Name="NewPass2Box" Grid.Row="2" Margin="0,34,0,0"/>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,12,0,0" Foreground="Tomato"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Anuluj" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Zmień hasło" Width="120" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
