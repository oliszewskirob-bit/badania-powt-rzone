<Window x:Class="ExportCsvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eksport CSV" Height="420" Width="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Eksport wpisów do CSV"/>

        <!-- Zakres dat -->
        <GroupBox Grid.Row="1" Header="Zakres dat" Margin="0,12,0,0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Od:" VerticalAlignment="Center"/>
                <DatePicker x:Name="FromDatePicker" Grid.Column="1" Width="160"/>

                <TextBlock Grid.Column="2" Text="Do:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <DatePicker x:Name="ToDatePicker" Grid.Column="3" Width="160"/>
            </Grid>
        </GroupBox>

        <!-- Co rozumiesz jako datę -->
        <GroupBox Grid.Row="2" Header="Jakie daty filtrować?" Margin="0,12,0,0">
            <StackPanel Margin="10">
                <RadioButton x:Name="DateFieldFirstPart" Content="Data I części badania" IsChecked="True"/>
                <RadioButton x:Name="DateFieldCreated" Content="Data utworzenia wpisu" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Filtry -->
        <GroupBox Grid.Row="3" Header="Filtry" Margin="0,12,0,0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Modalność:" VerticalAlignment="Center"/>
                <ComboBox x:Name="ModalityBox" Grid.Column="1" Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="Wszystkie" Tag="ALL" IsSelected="True"/>
                    <ComboBoxItem Content="CT"/>
                    <ComboBoxItem Content="MR"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="Status:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox x:Name="StatusBox" Grid.Column="3" Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="Wszystkie" Tag="ALL" IsSelected="True"/>
                    <ComboBoxItem Content="Nowe" Tag="new"/>
                    <ComboBoxItem Content="W trakcie" Tag="in_progress"/>
                    <ComboBoxItem Content="Zamknięte" Tag="closed"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Podgląd / info -->
        <TextBlock x:Name="InfoText" Grid.Row="4" Margin="0,12,0,0" Foreground="Gray" Text=""/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Generuj CSV" Width="140" Height="34" Margin="0,0,8,0" Click="Generate_Click"/>
            <Button Content="Zamknij" Width="120" Height="34" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
