<Window x:Class="AddEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj zgłoszenie" Height="720" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="18" FontWeight="SemiBold"
                   Text="Nowe zgłoszenie powtórzenia / uzupełnienia / wynaczynienia kontrastu"/>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 14 wierszy (0..13) -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!--0-->
                    <RowDefinition Height="Auto"/>
                    <!--1-->
                    <RowDefinition Height="Auto"/>
                    <!--2-->
                    <RowDefinition Height="Auto"/>
                    <!--3-->
                    <RowDefinition Height="Auto"/>
                    <!--4-->
                    <RowDefinition Height="Auto"/>
                    <!--5-->
                    <RowDefinition Height="Auto"/>
                    <!--6-->
                    <RowDefinition Height="Auto"/>
                    <!--7-->
                    <RowDefinition Height="Auto"/>
                    <!--8-->
                    <RowDefinition Height="Auto"/>
                    <!--9-->
                    <RowDefinition Height="Auto"/>
                    <!--10-->
                    <RowDefinition Height="Auto"/>
                    <!--11-->
                    <RowDefinition Height="Auto"/>
                    <!--12-->
                    <RowDefinition Height="Auto"/>
                    <!--13-->
                </Grid.RowDefinitions>

                <!-- Modalność -->
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,10,6" Text="Modalność (TK/MR)"/>
                <ComboBox x:Name="ModalityBox" Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" Width="160">
                    <ComboBoxItem Content="CT" IsSelected="True"/>
                    <ComboBoxItem Content="MR"/>
                </ComboBox>

                <!-- Typ -->
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,10,6" Text="Typ zgłoszenia"/>
                <ComboBox x:Name="EventTypeBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,6" Width="240">
                    <ComboBoxItem Content="Powtórzenie" Tag="repeat" IsSelected="True"/>
                    <ComboBoxItem Content="Uzupełnienie" Tag="supplement"/>
                    <ComboBoxItem Content="Wynaczynienie kontrastu" Tag="contrast_extravasation"/>
                </ComboBox>

                <!-- Aparat -->
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,10,6" Text="Aparat (np. TK1/MR1) *"/>
                <TextBox x:Name="DeviceBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,6" />

                <!-- Pacjent -->
                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,10,6" Text="Imię i nazwisko pacjenta *"/>
                <TextBox x:Name="PatientNameBox" Grid.Row="3" Grid.Column="1" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,10,6" Text="ID pacjenta *"/>
                <TextBox x:Name="PatientIdBox" Grid.Row="4" Grid.Column="1" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6,10,6" Text="Accession (opcjonalnie)"/>
                <TextBox x:Name="AccessionBox" Grid.Row="5" Grid.Column="1" Margin="0,6,0,6"/>

                <!-- Data -->
                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,6,10,6" Text="Data I części badania *"/>
                <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,6,0,6">
                    <DatePicker x:Name="FirstDatePicker" Width="160"/>
                    <TextBox x:Name="FirstTimeBox" Width="80" Margin="10,0,0,0" ToolTip="HH:mm" Text="08:00"/>
                    <TextBlock Margin="10,2,0,0" Foreground="Gray" Text="HH:mm"/>
                </DockPanel>

                <!-- Personel -->
                <!-- Lekarz -->
                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,6,10,6" Text="Lekarz zlecający poprawę *"/>
                <ComboBox x:Name="DoctorBox"
          Grid.Row="7" Grid.Column="1" Margin="0,6,0,6"
          MinWidth="240"
          IsEditable="True"
          IsTextSearchEnabled="True"/>

                <!-- Elektroradiolog -->
                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,6,10,6" Text="Elektroradiolog (I część) *"/>
                <ComboBox x:Name="TechBox"
          Grid.Row="8" Grid.Column="1" Margin="0,6,0,6"
          MinWidth="240"
          IsEditable="True"
          IsTextSearchEnabled="True"/>

                <!-- Pielęgniarka -->
                <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,6,10,6" Text="Pielęgniarka *"/>
                <ComboBox x:Name="NurseBox"
          Grid.Row="9" Grid.Column="1" Margin="0,6,0,6"
          MinWidth="240"
          IsEditable="True"
          IsTextSearchEnabled="True"/>



                <!-- Powód -->
                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,6,10,6" Text="Powód *"/>
                <ComboBox x:Name="ReasonBox" Grid.Row="10" Grid.Column="1" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,6,10,6" Text="Doprecyzowanie (gdy Inne)"/>
                <TextBox x:Name="ReasonOtherBox" Grid.Row="11" Grid.Column="1" Margin="0,6,0,6" IsEnabled="False"/>

                <!-- Opis -->
                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,6,10,6" Text="Opis (opcjonalnie)"/>
                <TextBox x:Name="DescBox" Grid.Row="12" Grid.Column="1" Margin="0,6,0,6"
                         AcceptsReturn="True" Height="90" TextWrapping="Wrap"/>

                <GroupBox x:Name="ContrastSection" Grid.Row="13" Grid.ColumnSpan="2" Header="Wynaczynienie kontrastu" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,10,6" Text="Jaki wenflon *"/>
                        <TextBox x:Name="ContrastCannulaBox" Grid.Row="0" Grid.Column="1" Margin="0,6,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,10,6" Text="Jaki kontrast *"/>
                        <TextBox x:Name="ContrastTypeBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,10,6" Text="Jaki przepływ *"/>
                        <TextBox x:Name="ContrastFlowBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,10,6" Text="Ile kontrastu *"/>
                        <TextBox x:Name="ContrastVolumeBox" Grid.Row="3" Grid.Column="1" Margin="0,6,0,6"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,10,6" Text="Kontrast widoczny w badaniu *"/>
                        <ComboBox x:Name="ContrastVisibleBox" Grid.Row="4" Grid.Column="1" Margin="0,6,0,6" Width="160">
                            <ComboBoxItem Content="Tak"/>
                            <ComboBoxItem Content="Nie"/>
                        </ComboBox>

                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6,10,6" Text="Poinformowano oddział *"/>
                        <ComboBox x:Name="WardNotifiedBox" Grid.Row="5" Grid.Column="1" Margin="0,6,0,6" Width="160">
                            <ComboBoxItem Content="Tak"/>
                            <ComboBoxItem Content="Nie"/>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,6,10,6" Text="Przekazano pacjentowi zalecenia *"/>
                        <ComboBox x:Name="PatientInstructionsBox" Grid.Row="6" Grid.Column="1" Margin="0,6,0,6" Width="160">
                            <ComboBoxItem Content="Tak"/>
                            <ComboBoxItem Content="Nie"/>
                        </ComboBox>

                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,6,10,6" Text="Dodatkowe informacje"/>
                        <TextBox x:Name="ContrastAdditionalInfoBox" Grid.Row="7" Grid.Column="1" Margin="0,6,0,6"
                                 AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- Dół -->
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="ErrorText" Foreground="Tomato" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Anuluj" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Zapisz" Width="120" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
