<Window x:Class="UserResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset hasła" Height="280" Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   FontSize="16" FontWeight="SemiBold"
                   Text="Reset hasła"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,14,10,6" Text="Użytkownik"/>
        <TextBox x:Name="UserInfoBox" Grid.Row="1" Grid.Column="1" Margin="0,14,0,6" IsReadOnly="True"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,10,6" Text="Nowe hasło"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,6"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,10,6" Text="Powtórz hasło"/>
        <PasswordBox x:Name="Password2Box" Grid.Row="3" Grid.Column="1" Margin="0,6,0,6"/>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="4" Grid.ColumnSpan="2"
                   Foreground="Tomato"
                   Margin="0,8,0,0"
                   Text=""/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Zapisz" Width="120" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Anuluj" Width="120" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
