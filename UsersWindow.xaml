<Window x:Class="UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Użytkownicy" Height="520" Width="820"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Zarządzanie użytkownikami"/>
            <TextBlock x:Name="InfoText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="Gray"/>
        </DockPanel>

        <DataGrid x:Name="UsersGrid"
                  Grid.Row="1"
                  Margin="0,12,0,12"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                <DataGridTextColumn Header="Imię i nazwisko" Binding="{Binding DisplayName}" Width="220"/>
                <DataGridTextColumn Header="Rola" Binding="{Binding Role}" Width="90"/>
                <DataGridCheckBoxColumn Header="Aktywny" Binding="{Binding IsActive}" Width="80"/>
                <DataGridTextColumn Header="Utworzono" Binding="{Binding CreatedAt}" Width="160"/>
                <DataGridTextColumn Header="Kto" Binding="{Binding CreatedBy}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Odśwież" Width="110" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Dodaj konto" Width="130" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Reset hasła" Width="130" Margin="0,0,8,0" Click="ResetPwd_Click"/>
            <Button Content="Aktywuj/Dezaktywuj" Width="170" Margin="0,0,8,0" Click="ToggleActive_Click"/>
            <Button Content="Zamknij" Width="110" Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
