<Window x:Class="QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notatka" Height="260" Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" Text="Notatka"/>

        <TextBox x:Name="NotesBox" Grid.Row="1" Margin="0,12,0,12"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Zapisz" Width="120" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Anuluj" Width="120" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
